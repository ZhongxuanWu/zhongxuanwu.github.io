{% assign months = 'january|february|march|april|may|june|july|august|september|october|november|december' | split: '|' %}

{% assign parts = include.date | strip | split: '-' %}
{% assign year = parts[0] %}
{% assign m = parts[1] | minus: 1 %}
{% capture month %}{{ months[m] }}{% endcapture %}
{% capture month %}{{ site.data[site.active_lang].strings.months[include.format][month] }}{% endcapture %}
{% if parts.size == 2 %}
  {% assign day = nil %}
{% else %}
  {%- assign day = parts[2] -%}
{% endif %}

{% comment %}
  Here, add language specific date formats
{% endcomment %}
{% if parts.size == 2 %}
  {%- if site.active_lang == 'zh' -%}
    {{ year }}年{{ month }}
  {%- else -%}
    {{ month }} {{ year }}
  {%- endif -%}
{% else %}
  {%- if site.active_lang == 'en' -%}
    {{ month }} {{ day }}, {{ year }}
  {%- elsif site.active_lang == 'fr' -%}
    {{ day }} {{ month }}, {{ year }}
  {%- elsif site.active_lang == 'pt' -%}
    {{ day }} de {{ month }}, {{ year }}
  {%- elsif site.active_lang == 'zh' -%}
    {{ year }}年{{ month }}{{ day }}日
  {%- else -%}
    {{ day }} {{ month }} {{ year }}
  {%- endif -%}
{% endif %}