    defer
    src="https://tikzjax.com/v1/tikzjax.js"
    integrity="sha256-+1qyucCXRZJrCg3lm3KxRt/7WXaYhBid4/1XJRHGB1E="
    crossorigin="anonymous"
  ></script>
{% endif %}

{% if page.typograms %}
  <!-- Typograms -->
  <script src="{{ '/assets/js/typograms.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

