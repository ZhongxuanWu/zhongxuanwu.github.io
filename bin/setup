#!/usr/bin/env bash
set -euo pipefail

REPOSITORY_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPOSITORY_ROOT"

EXPECTED_RUBY="$(tr -d '[:space:]' < .ruby-version)"
EXPECTED_NODE="$(tr -d '[:space:]' < .nvmrc)"
EXPECTED_PYTHON="$(tr -d '[:space:]' < .python-version)"
BUNDLER_VERSION="4.0.4"
PIP_VERSION="24.0"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Required command not found: $1" >&2
    exit 1
  fi
}

require_version() {
  local tool="$1"
  local expected="$2"
  local actual="$3"
  if [[ "$actual" != "$expected" ]]; then
    echo "$tool $expected is required; found $actual." >&2
    exit 1
  fi
}

require_command ruby
require_command gem
require_command node
require_command npm
require_command python3
python3 -m pip --version >/dev/null

require_version "Ruby" "$EXPECTED_RUBY" "$(ruby -e 'print RUBY_VERSION')"
require_version "Node.js" "$EXPECTED_NODE" "$(node --version | sed 's/^v//')"
require_version "Python" "$EXPECTED_PYTHON" "$(python3 -c 'import platform; print(platform.python_version())')"

if ! gem list --installed --exact bundler --version "$BUNDLER_VERSION" >/dev/null; then
  gem install bundler --version "$BUNDLER_VERSION" --no-document
fi

bundle _${BUNDLER_VERSION}_ config set --local path vendor/bundle
bundle _${BUNDLER_VERSION}_ install

python3 -m venv --clear --without-pip .venv
python3 -m pip --python .venv install "pip==$PIP_VERSION"
.venv/bin/python -m pip install --requirement requirements.txt

npm ci
npx --no-install playwright install chromium

if ! command -v magick >/dev/null 2>&1 && ! command -v convert >/dev/null 2>&1; then
  echo "ImageMagick is required. Install it with: sudo apt install imagemagick" >&2
  exit 1
fi

echo "Setup complete. Start the site with ./bin/dev."
