#!/usr/bin/env bash

REPOSITORY_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
JEKYLL_CONFIG_FILES=("_config.yml" "_config.features.yml" "_config.libraries.yml")
JEKYLL_CONFIG="$(IFS=,; echo "${JEKYLL_CONFIG_FILES[*]}")"

cd "$REPOSITORY_ROOT"

require_file() {
  if [[ ! -f "$1" ]]; then
    echo "Required file not found: $1" >&2
    exit 1
  fi
}

require_executable() {
  if [[ ! -x "$1" ]]; then
    echo "Required tool not found: $1. Run ./bin/setup first." >&2
    exit 1
  fi
}

prepare_build_environment() {
  local config_file
  for config_file in "${JEKYLL_CONFIG_FILES[@]}"; do
    require_file "$config_file"
  done

  require_executable ".venv/bin/jupyter"
  require_executable "node_modules/.bin/purgecss"
  export PATH="$REPOSITORY_ROOT/.venv/bin:$REPOSITORY_ROOT/node_modules/.bin:$PATH"
}
